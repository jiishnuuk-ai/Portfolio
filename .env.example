# The secret address of your admin page, e.g. studio-k7x2m9 gives
# http://localhost:3000/studio-k7x2m9/
# Use 8+ letters, numbers, - or _. Make it hard to guess and don't share it.
ADMIN_PATH=studio-k7x2m9

# Optional
PORT=3000
MAX_UPLOAD_MB=200
